generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes                 Note[]
  noteCategories        NoteCategory[]
  calendarEvents        CalendarEvent[]
  reminders             Reminder[]
  habits                Habit[]
  habitLogs             HabitLog[]
  financeCategories     FinanceCategory[]
  financeTransactions   FinanceTransaction[]

  @@map("users")
}

model NoteCategory {
  id        Int      @id @default(autoincrement())
  name      String
  color     String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@map("note_categories")
}

model Note {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  isFavorite  Boolean  @default(false)
  userId      Int
  categoryId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("notes")
}

model CalendarEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

model Reminder {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  userId      Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Habit {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  frequency   HabitFrequency @default(DAILY)
  goal        Int?
  color       String?
  userId      Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  userId    Int
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model FinanceCategory {
  id        Int             @id @default(autoincrement())
  name      String
  type      TransactionType
  color     String?
  userId    Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@map("finance_categories")
}

model FinanceTransaction {
  id              Int             @id @default(autoincrement())
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  description     String?
  transactionDate DateTime
  userId          Int
  categoryId      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("finance_transactions")
}